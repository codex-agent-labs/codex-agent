<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CodexAgent</PackageId>
    <RootNamespace>CodexAgent</RootNamespace>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>codex-agent-labs</Authors>
    <Description>Idiomatic .NET bindings for the local Codex Agent desktop runtime.</Description>
    <PackageTags>codex;agent;native;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/codex-agent-labs/codex-agent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../native/osx-arm64/libcodex_agent.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" Condition="Exists('../../native/osx-arm64/libcodex_agent.dylib')" />
    <None Include="../../native/osx-x64/libcodex_agent.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" Condition="Exists('../../native/osx-x64/libcodex_agent.dylib')" />
    <None Include="../../native/linux-arm64/libcodex_agent.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" Condition="Exists('../../native/linux-arm64/libcodex_agent.so')" />
    <None Include="../../native/linux-x64/libcodex_agent.so" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="Exists('../../native/linux-x64/libcodex_agent.so')" />
    <None Include="../../native/win-x64/codex_agent.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('../../native/win-x64/codex_agent.dll')" />
    <None Include="../../native/**/codex-agent-c-abi-manifest.json" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
    <None Include="../../native/**/codex-agent-c-abi-evidence.json" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RequireCodexAgentNativeAssets" BeforeTargets="GenerateNuspec" Condition="'$(CodexAgentRequireNativeAssets)' == 'true'">
    <Error Condition="!Exists('../../native/osx-arm64/libcodex_agent.dylib')" Text="Missing osx-arm64 Codex Agent C SDK library." />
    <Error Condition="!Exists('../../native/osx-x64/libcodex_agent.dylib')" Text="Missing osx-x64 Codex Agent C SDK library." />
    <Error Condition="!Exists('../../native/linux-arm64/libcodex_agent.so')" Text="Missing linux-arm64 Codex Agent C SDK library." />
    <Error Condition="!Exists('../../native/linux-x64/libcodex_agent.so')" Text="Missing linux-x64 Codex Agent C SDK library." />
    <Error Condition="!Exists('../../native/win-x64/codex_agent.dll')" Text="Missing win-x64 Codex Agent C SDK library." />
  </Target>
</Project>
