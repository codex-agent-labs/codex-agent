{
  "name": "@codex-agent-labs/codex-agent",
  "version": "@VERSION@",
  "description": "Node.js SDK for the local Codex Agent Desktop runtime",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./index.d.ts",
        "import": "./index.mjs",
        "require": "./index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "browser": false,
  "files": [
    "dist",
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codex-agent-labs/codex-agent.git"
  },
  "bugs": {
    "url": "https://github.com/codex-agent-labs/codex-agent/issues"
  },
  "homepage": "https://github.com/codex-agent-labs/codex-agent#readme"
}
